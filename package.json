{
  "name": "rescuegrid-ai",
  "version": "1.0.0",
  "description": "Collaborative Multi-Agent Emergency Response & Coordination System",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/index.ts",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "tsx server/index.ts"
  },
  "keywords": [
    "multi-agent",
    "emergency-response",
    "moss",
    "gemini",
    "collaboration",
    "hackathon"
  ],
  "author": "RescueGrid Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.22.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
